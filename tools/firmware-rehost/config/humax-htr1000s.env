# ==========================================================================
# Cihaz Config — Humax HTR-1000S Uydu Alıcısı
# ==========================================================================
# SoC: Broadcom BCM7358 (MIPS big-endian)
# NAND: Spansion S34ML01G200BHI00 (1Gbit = 128MB SLC NAND, BGA-63)
# Analiz hedefi: Kanal şifreleme, AES anahtar yönetimi, firmware güncelleme
# mekanizması, UART alternatifi olarak firmware rehosting
# ==========================================================================

DEVICE_NAME="Humax HTR-1000S"
DEVICE_SOC="BCM7358"
DEVICE_ARCH="mips"

# --- NAND döküm dosyası ---
# Programlayıcıdan okunan ham NAND dökümü.
# Chip: Spansion S34ML01G200BHI00 (1Gbit = 128MB SLC NAND, BGA-63)
# OOB dahil dosya boyutu: 138,412,032 byte (65536 sayfa × 2112)
# OOB hariç temiz boyut: 134,217,728 byte (128MB)
NAND_DUMP_PATH="$HOME/firmware-dumps/S34ML01G200BHI00@BGA63_2147.BIN"
NAND_PAGE_SIZE="2048"
NAND_OOB_SIZE="64"

# --- Çıktı dizini ---
EXTRACT_DIR="$HOME/firmware-analysis/humax-htr1000s"

# --- Taşıyıcı (donor) kernel ---
# OpenWrt Malta MIPS big-endian kernel'i.
# İndirme komutu (Mac):
#   curl -L -o ~/firmware-analysis/kernels/openwrt-malta-be-vmlinux-initramfs.elf \
#     "https://downloads.openwrt.org/releases/23.05.5/targets/malta/be/\
#      openwrt-23.05.5-malta-be-vmlinux-initramfs.elf"
DONOR_KERNEL_PATH="$HOME/firmware-analysis/kernels/openwrt-malta-be-vmlinux-initramfs.elf"
DONOR_ARCH="mips"

# --- QEMU ayarları ---
QEMU_MACHINE="malta"
QEMU_MEMORY="256"
QEMU_NET_HOST_PORT="2222"
QEMU_NET_GUEST_PORT="22"

# --- Analiz hedefleri ---
# Humax STB'lerde bilinen kriptografi konumları:
# - /usr/lib/libcrypto.so (OpenSSL)
# - /usr/bin/openssl
# - Proprietary: /usr/local/bin/humax_*, /app/bin/*
# - CAS (Conditional Access System) modülleri: /usr/lib/cas/
CRYPTO_PATTERNS="aes AES openssl libcrypto des3 sha256 encrypt decrypt hmac \
    cas conax irdeto nagra viaccess smartcard descramble"
INIT_SCRIPT_DIR="/etc/init.d"
TARGET_BINARIES="/usr/local/bin/humax_update /app/bin/cas_manager"

# --- Notlar ---
NOTES="BCM7358 big-endian MIPS32. UART (115200 8N1) normalde kapalı/disabled. \
TV GUI ve donanım dekoderi (MPEG/HDMI/DVB-S2) QEMU'da çalışmaz ama OS omurgası, \
dosya sistemi ve yazılımsal kriptografi ayakta kalır. SquashFS büyük olasılıkla \
LZMA veya XZ sıkıştırmalı. JFFS2 overlay partition'ı da olabilir (kullanıcı \
ayarları, kanal listesi, kayıtlı programlar)."
