# ==========================================================================
# Firmware Rehosting Toolkit — Cihaz Config Şablonu
# ==========================================================================
# Yeni bir cihaz analizi için bu dosyayı kopyala:
#   cp config/template.env config/<cihaz-adi>.env
# Sonra aşağıdaki değerleri hedef cihaza göre düzenle.
# ==========================================================================

# --- Hedef cihaz bilgileri ---
DEVICE_NAME="Cihaz Adı"
DEVICE_SOC="BCM7358"
DEVICE_ARCH="mips"

# --- NAND döküm dosyası ---
# Programlayıcıdan okunan ham NAND döküm dosyasının tam yolu.
NAND_DUMP_PATH="$HOME/firmware-dumps/CIHAZ-ADI.bin"
# NAND sayfa boyutu (byte). Çoğu SLC NAND için 2048.
NAND_PAGE_SIZE="2048"
# NAND OOB (spare area) boyutu (byte). Genelde 64.
NAND_OOB_SIZE="64"

# --- Binwalk çıktı dizini ---
# Binwalk'un firmware'den çıkardığı dosyaların konacağı yer.
EXTRACT_DIR="$HOME/firmware-analysis/CIHAZ-ADI"

# --- Taşıyıcı (donor) kernel ---
# QEMU'da boot edecek MIPS kernel. OpenWrt Malta MIPS kernel'i önerilir.
# İndirme: https://downloads.openwrt.org/releases/ altından
# malta/generic/ dizininden *-initramfs-kernel.bin dosyası.
DONOR_KERNEL_PATH="$HOME/firmware-analysis/kernels/openwrt-mips-malta-vmlinux-initramfs.elf"
# Donor kernel mimarisi: mips (big-endian) veya mipsel (little-endian)
# BCM63xx (TD-W9970): mips (big-endian)
# BCM7xxx (Humax): mips (big-endian)
DONOR_ARCH="mips"

# --- QEMU ayarları ---
QEMU_MACHINE="malta"
QEMU_MEMORY="256"
QEMU_NET_HOST_PORT="2222"
QEMU_NET_GUEST_PORT="22"

# --- Analiz hedefleri ---
# RootFS içinde aranacak kriptografi ipuçları (boşlukla ayrılmış)
CRYPTO_PATTERNS="aes AES openssl libcrypto des3 sha256 encrypt decrypt"
# İncelenecek başlatma betik dizini (rootfs içinde)
INIT_SCRIPT_DIR="/etc/init.d"
# Hedef binary'ler (rootfs içinde, boşlukla ayrılmış)
TARGET_BINARIES=""

# --- Notlar ---
NOTES="Cihaza özel notlarını buraya yaz."
