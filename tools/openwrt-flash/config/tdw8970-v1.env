# ==========================================================================
# Cihaz Config — TP-Link TD-W8970 v1 / v1.2
# ==========================================================================
# Kaynak: https://openwrt.org/toh/tp-link/td-w8970_v1
# NOT: v3 sürümü Broadcom'dur ve bu config'le UYUMLU DEĞİLDİR / desteklenmez.
# ==========================================================================

DEVICE_NAME="TP-Link TD-W8970 v1"
DEVICE_TOH_URL="https://openwrt.org/toh/tp-link/td-w8970_v1"

# --- Seri (UART) bağlantı ayarları ---
# Adaptör takıldığında gerçek portu `ls /dev/ttyUSB*` ile doğrula, farklıysa güncelle.
SERIAL_PORT="/dev/ttyUSB0"
SERIAL_BAUD="115200"

# --- Ağ ayarları (U-Boot / TFTP) ---
ROUTER_IP="192.168.1.1"
TFTP_SERVER_IP="192.168.1.2"
BOARD_ARG="WD8970"

# --- TFTP dosya paylaşımı ---
TFTP_ROOT_DIR="$HOME/tftpboot"
FIRMWARE_TFTP_NAME="openwrt-tdw8970-sysupgrade.bin"

# --- Firmware kaynağı ---
# firmware-selector.openwrt.org üzerinde "tp-link_td-w8970-v1" ara,
# Sysupgrade imajını indirip tam yolunu buraya yaz.
FIRMWARE_SOURCE_PATH="$HOME/Downloads/openwrt-25.12.2-lantiq-xrx200-tplink_tdw8970-v1-squashfs-sysupgrade.bin"

# --- (ÖNERİLİR) RAM'den test-boot için initramfs imajı ---
# Aynı firmware-selector aramasında "Initramfs" seçeneğiyle ayrıca indirilir.
# Flash'a hiçbir şey yazmadan önce bununla test etmen şiddetle tavsiye edilir.
INITRAMFS_SOURCE_PATH="$HOME/Downloads/openwrt-25.12.2-lantiq-xrx200-tplink_tdw8970-v1-initramfs-kernel.bin"
INITRAMFS_TFTP_NAME="openwrt-tdw8970-initramfs.bin"

# --- U-Boot flash adresleri ---
RAM_LOAD_ADDR="0x81000000"
FLASH_ERASE_START="0x20000"
FLASH_ERASE_SIZE="0x7a0000"

# --- Notlar ---
NOTES="Radio/kalibrasyon partition'ı (0x7f0000 sonrası) ASLA silinmemeli — \
WLAN kalibrasyonu ve MAC adresi orada. UART adaptörü 3.3V olmalı, 5V değil. \
J7 pin sırası (yukarıdan aşağı): VCC(3.3V)-GND-Rx-Tx; sadece GND/RX/TX bağla."
