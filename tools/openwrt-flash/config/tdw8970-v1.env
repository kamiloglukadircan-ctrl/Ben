# ==========================================================================
# Cihaz Config — TP-Link TD-W8970 v1 / v1.2
# ==========================================================================
# Kaynak: https://openwrt.org/toh/tp-link/td-w8970_v1
# NOT: v3 sürümü Broadcom'dur ve bu config'le UYUMLU DEĞİLDİR / desteklenmez.
# ==========================================================================

DEVICE_NAME="TP-Link TD-W8970 v1"
DEVICE_TOH_URL="https://openwrt.org/toh/tp-link/td-w8970_v1"

# --- Seri (UART) bağlantı ayarları ---
# Adaptör takıldığında gerçek portu `ls /dev/ttyUSB*` ile doğrula, farklıysa güncelle.
SERIAL_PORT="/dev/ttyUSB0"
SERIAL_BAUD="115200"

# --- Ağ ayarları (U-Boot / TFTP) ---
ROUTER_IP="192.168.1.1"
TFTP_SERVER_IP="192.168.1.2"
BOARD_ARG="WD8970"

# --- TFTP dosya paylaşımı ---
TFTP_ROOT_DIR="$HOME/tftpboot"
FIRMWARE_TFTP_NAME="openwrt-tdw8970-sysupgrade.bin"

# --- Firmware kaynağı ---
# firmware-selector.openwrt.org'da gerçek platform "lantiq/xrx200_legacy"
# çıktı (varsayılan "xrx200" değil) ve güncel sürüm 25.12.5 idi (2026-09-26
# itibarıyla). Aşağıdaki dosya adları gerçekten indirilenlerle eşleşiyor.
FIRMWARE_SOURCE_PATH="$HOME/Downloads/openwrt-25.12.5-lantiq-xrx200_legacy-tplink_tdw8970-squashfs-sysupgrade.bin"

# --- (ÖNERİLİR) RAM'den test-boot için initramfs/kernel imajı ---
# firmware-selector'da bu hedefte "Initramfs" değil "KERNEL" adıyla listelendi
# ("Asgari dosya sistemini içeren Linux çekirdeği — ilk kurulum/kurtarma için").
# Aynı işi görüyor: flash'a hiçbir şey yazmadan RAM'den boot etmeyi sağlıyor.
INITRAMFS_SOURCE_PATH="$HOME/Downloads/openwrt-25.12.5-lantiq-xrx200_legacy-tplink_tdw8970-initramfs-kernel.bin"
INITRAMFS_TFTP_NAME="openwrt-tdw8970-initramfs.bin"

# --- U-Boot flash adresleri ---
RAM_LOAD_ADDR="0x81000000"
FLASH_ERASE_START="0x20000"
FLASH_ERASE_SIZE="0x7a0000"

# --- OEM firmware yedeği ---
# 2026-09-26'da bu cihazda U-Boot üzerinden (sf read + md.b) kontrol edildi:
# - kernel (0x20000): kısmen dolu ama bozuk (LZMA decompress hatası veriyor,
#   muhtemelen yarım kalmış önceki bir flaşlama denemesinden)
# - romfile (0x7d0000) ve radio (0x7f0000): TAMAMEN 0xFF (silinmiş, boş) —
#   yedeklenecek bir şey kalmamış
# MAC adresi kayıp değil: U-Boot'un kendi ortam değişkeninden zaten biliniyor
# (boot banner'da "MAC: c4-6e-1f-40-d2-8e" olarak görünüyor).
# Bu yüzden BACKUP_PARTITIONS bilerek boş bırakıldı — bu cihazda OS'a
# hiç girmeden (OEM kernel bozuk olduğu için giremiyoruz zaten) direkt
# flaşlamaya geçildi.
BACKUP_DIR="$HOME/openwrt-backups/tdw8970-v1"
BACKUP_PARTITIONS=""

# --- Notlar ---
NOTES="Radio/kalibrasyon partition'ı (0x7f0000 sonrası) bu ünitede zaten \
silinmiş durumda (WLAN varsayılan kalibrasyonla çalışacak). MAC adresi: \
c4-6e-1f-40-d2-8e (U-Boot ortam değişkeninden). UART adaptörü 3.3V olmalı, \
5V değil. J7 pin sırası (yukarıdan aşağı): VCC(3.3V)-GND-Rx-Tx; sadece \
GND/RX/TX bağla. sf probe için argüman gerekiyor: 'sf probe 3'."
