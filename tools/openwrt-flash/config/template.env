# ==========================================================================
# OpenWrt Flash Toolkit — Cihaz Config Şablonu
# ==========================================================================
# Yeni bir cihaz kurulumu için bu dosyayı kopyala:
#   cp config/template.env config/<cihaz-adi>.env
# Sonra sadece aşağıdaki değerleri o cihaza göre düzenle. scripts/ altındaki
# hiçbir script'i değiştirmene gerek yok — hepsi bu config dosyasını okuyor.
# ==========================================================================

# --- Kimlik / belgeleme amaçlı ---
DEVICE_NAME="Cihaz Adı v1"
DEVICE_TOH_URL="https://openwrt.org/toh/vendor/model_v1"

# --- Seri (UART) bağlantı ayarları ---
SERIAL_PORT="/dev/ttyUSB0"
SERIAL_BAUD="115200"
# 8N1 sabit kabul ediliyor (çoğu Lantiq/OpenWrt cihazında standart)

# --- Ağ ayarları (U-Boot / TFTP) ---
ROUTER_IP="192.168.1.1"        # U-Boot'ta setenv ipaddr
TFTP_SERVER_IP="192.168.1.2"   # bilgisayarının router'a bakan arayüzündeki IP
BOARD_ARG=""                    # U-Boot bootargs içindeki board= değeri (varsa)

# --- TFTP dosya paylaşımı ---
# Bilgisayarında çalışan TFTP server'ın kök dizini (tftpd-hpa/dnsmasq config'i
# ile eşleşmeli). Script bu dizine firmware'i kopyalar.
TFTP_ROOT_DIR="$HOME/tftpboot"
# TFTP üzerinden görünecek dosya adı (kısa/sabit tutmak U-Boot'ta yazması
# kolay olsun diye önerilir)
FIRMWARE_TFTP_NAME="openwrt-sysupgrade.bin"

# --- Firmware kaynağı ---
# firmware-selector.openwrt.org'dan indirdiğin GERÇEK dosyanın tam yolu.
# Script bunu TFTP_ROOT_DIR/FIRMWARE_TFTP_NAME olarak kopyalar.
FIRMWARE_SOURCE_PATH="$HOME/Downloads/openwrt-XX.XX.X-target-DEGISTIR-sysupgrade.bin"

# --- U-Boot flash adresleri (cihaza göre DEĞİŞİR — ToH sayfasındaki
#     "Flash layout" ve Installation bölümünden al) ---
RAM_LOAD_ADDR="0x81000000"     # tftpboot'un imajı yükleyeceği RAM adresi
FLASH_ERASE_START="0x20000"    # firmware partition'ının başlangıcı
FLASH_ERASE_SIZE="0x7a0000"    # silinecek/yazılacak alanın boyutu

# --- Notlar ---
# Bu satırın altına cihaza özel uyarıları/istisnaları ekleyebilirsin
# (örn. "radio partition'a dokunma", "v3 farklı SoC kullanıyor" gibi).
NOTES="Buraya cihaza özel notlarını yaz."
